# Python 缓存
__pycache__/
*.py[cod]

# Blender 自动备份与临时文件
*.blend@
*.blend.tmp

# 本地运行日志
*.log
error.log
game.log

# 临时导出目录
tmp/
temp/

# 系统文件
Thumbs.db
Desktop.ini
*.lnk

# Node / Playwright 本地依赖与浏览器会话缓存
node_modules/
tools/crawler/.npm-cache/
tools/crawler/.playwright-browsers/
tools/crawler/.playwright-profile/
tools/crawler/artifacts/

# 本地知识库 SQLite 数据库：由已提交的目录数据与工具重建，不提交二进制文件。
knowledge/database/*.sqlite
knowledge/database/*.sqlite-shm
knowledge/database/*.sqlite-wal

# 本地视觉参考缓存：允许下载或复制来源待核验的图片，但绝不提交二进制参考素材。
art/reference_library/**
!art/reference_library/README.md

# 概念图、模型预览和实机影像默认保存在本地。制作输入、模型与游戏贴图继续入库。
/art/concepts/**/*.png
/art/concepts/**/*.jpg
/art/concepts/**/*.jpeg
/art/concepts/**/*.webp
/art/concepts/**/*.gif
/art/concepts/**/*.mp4
/art/concepts/**/*.webm
!/art/concepts/**/motion_source/**
/art/models/**/previews/**/*.png
/art/models/**/previews/**/*.jpg
/art/models/**/previews/**/*.jpeg
/art/models/**/previews/**/*.webp
/art/models/**/previews/**/*.gif
/art/models/**/previews/**/*.mp4
/art/models/**/previews/**/*.webm
/reports/images/**/*.png
/reports/images/**/*.jpg
/reports/images/**/*.jpeg
/reports/images/**/*.webp
/reports/images/**/*.gif
/reports/images/**/*.mp4
/reports/images/**/*.webm

# 爱缪莎旗舰隔离原型的本地组装与测试产物；源骨架仍纳入版本控制。
tools/prototypes/aemusa_flagship/build/
tools/prototypes/aemusa_flagship/test_output/

# 本机隔离试玩存档和输入证据；结构化核对结果保存在reports，不提交二进制存档。
/runtime-backups/
