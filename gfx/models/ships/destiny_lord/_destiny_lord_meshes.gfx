# 命运之主的群星 PDX 网格注册表。
# 三段自定义 .mesh 已由 io_pdx_mesh 导出；贴图将在同目录以 DDS 格式提供。
objectTypes = {
	pdxmesh = {
		name = "destiny_lord_bow_mesh"
		file = "gfx/models/ships/destiny_lord/destiny_lord_bow.mesh"
		# 视觉尺度对标时隙之梭：三段统一放大，保持舰体拼接与武器定位器比例一致。
		scale = 6.0
		meshsettings = {
			name = "destiny_lord_bow"
			index = 0
			texture_diffuse = "destiny_lord_basecolor.dds"
			texture_normal = "destiny_lord_normal.dds"
			texture_specular = "destiny_lord_specular.dds"
			shader = "PdxMeshShip"
		}
	}

	pdxmesh = {
		name = "destiny_lord_mid_mesh"
		file = "gfx/models/ships/destiny_lord/destiny_lord_mid.mesh"
		# 视觉尺度对标时隙之梭：三段统一放大，保持舰体拼接与武器定位器比例一致。
		scale = 6.0
		meshsettings = {
			name = "destiny_lord_mid"
			index = 0
			texture_diffuse = "destiny_lord_basecolor.dds"
			texture_normal = "destiny_lord_normal.dds"
			texture_specular = "destiny_lord_specular.dds"
			shader = "PdxMeshShip"
		}
	}

	pdxmesh = {
		name = "destiny_lord_stern_mesh"
		file = "gfx/models/ships/destiny_lord/destiny_lord_stern.mesh"
		# 视觉尺度对标时隙之梭：三段统一放大，保持舰体拼接与武器定位器比例一致。
		scale = 6.0
		meshsettings = {
			name = "destiny_lord_stern"
			index = 0
			texture_diffuse = "destiny_lord_basecolor.dds"
			texture_normal = "destiny_lord_normal.dds"
			texture_specular = "destiny_lord_specular.dds"
			shader = "PdxMeshShip"
		}
	}
}
