  "project_contract": {
    "slot": "每颗殖民地一个R1公共项目槽，进行态及收益期内均不能开启另一模式；不占用C2或既有角色工坊槽。",
    "entry": "玩家文明、拥有并实际控制的殖民地、无轰炸、相应科技与至少一座列明现场设施。",
    "cost": "开始时一次扣费，无逐月追加收费；完成或中止不返还，不发放免费建筑、科技或角色经验。",
    "progress": "每次有效原生月度脉冲推进1步；通常约3或4个月，不宣称固定90或120日。仅处理进行态地点。",
    "pause": "同一所有者的现场遭占领、轰炸或失去本模式的全部合格设施时暂停，已付费及工作量保留；同类低级楼升级成合格高级楼不暂停。",
    "abort": "所有权变化、殖民地消失、文明身份不再符合或玩家主动中止时失败归档，已付费不返还；不得转移给新所有者或首都。",
    "completion": "最后一步同时复核所有者、控制权、轰炸与设施；先清进行态再添加一项收益，重复进入界面不推进或再结算。",
    "benefit": "收益绑定启动时原殖民地；占领不刷新收益期限，失去所有权时移除本包收益；完工后拆楼不重新结算或退款。",
    "save": "现场、启动所有者、模式、已付费事实、有效工作步及结算状态随档；载档后等待下一次自然月度脉冲，不补跑历史月份。",
    "limits": "不增加角色等级、人物组合、个人授权或全局样本资源；不改变C2、旧首都工坊和主线回调。"
  },
